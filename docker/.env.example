# cloneAIProject 环境变量配置（复制为 .env 使用）

# PostgreSQL
POSTGRES_USER=cloneai
POSTGRES_PASSWORD=cloneai_pass
POSTGRES_DB=hotspot_monitor
POSTGRES_PORT=15432

# Redis
REDIS_PORT=16379

# 服务端口
LOGIN_PORT=3459
HOTSPOT_PORT=8000

# 登录保活间隔（秒）
KEEPALIVE_INTERVAL_SECONDS=1800

# 热点监控服务
DEBUG=false

# LLM：OpenAI兼容协议，一个Key一套配置，改 BASE_URL/MODEL 即切换厂商
# DeepSeek:  https://api.deepseek.com/v1      模型: deepseek-chat
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1  模型: qwen-plus
# OpenAI:    https://api.openai.com/v1        模型: gpt-4o
# Kimi:      https://api.moonshot.cn/v1       模型: moonshot-v1-8k
# GLM:       https://open.bigmodel.cn/api/paas/v4  模型: glm-4
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ASR语音识别：Whisper兼容协议，改 BASE_URL/MODEL 即切换
# SiliconFlow(有免费额度): https://api.siliconflow.cn/v1   模型: SenseVoiceSmall
# OpenAI Whisper:          https://api.openai.com/v1      模型: whisper-1
# Groq(免费额度大):         https://api.groq.com/openai/v1 模型: whisper-large-v3
ASR_API_KEY=
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=SenseVoiceSmall
